rules_version = '2';
// Firebase Storage 보안 규칙 — 후기 첨부 이미지
// 배포: firebase deploy --only storage  (Firebase 콘솔에서 Storage를 먼저 시작해야 합니다)
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'warmcomfortforyou@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // reviews/{후기ID}/{파일명} — 공개 후기 페이지에 표시되므로 읽기는 공개, 업로드·삭제는 관리자만
    // (관리자 화면이 업로드 전에 이미지를 줄이고 EXIF 위치정보 등 메타데이터를 제거합니다)
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

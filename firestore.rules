rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 확인 — 이메일 검증까지 요구해 다른 로그인 방식으로 이메일을 사칭하는 것을 방지
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'warmcomfortforyou@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      // 본인 또는 관리자(가입자 관리 대시보드)만 읽기
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 공개 프로필(닉네임/소속/좋아요 크레딧) — 게시판·랭킹 표시용. 이메일 등 민감정보는 없음
    match /leaderboard/{uid} {
      allow read: if true;
      // 본인이 프로필 저장 시 생성 — 최초 크레딧은 0
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 50
        && request.resource.data.affiliation is string && request.resource.data.affiliation.size() <= 60
        && request.resource.data.get('likeCredits', 0) == 0;
      allow update: if request.auth != null && (
        // 본인은 닉네임/소속만 수정 가능
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'affiliation', 'updatedAt'])
          && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 50
          && request.resource.data.affiliation is string && request.resource.data.affiliation.size() <= 60)
        ||
        // 글에 좋아요를 누른 사람이 작성자의 크레딧을 ±1만 갱신 (좋아요/좋아요 취소)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCredits'])
          && request.resource.data.likeCredits is int
          && request.resource.data.likeCredits >= 0
          && (request.resource.data.likeCredits - resource.data.get('likeCredits', 0)) in [1, -1])
      );
      allow delete: if isAdmin();
    }

    // 필로소피 AI 봉사단 소식 — 누구나 읽기, 관리자만 쓰기
    match /volunteer_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 필로소피 AI 교육 사진 — 누구나 읽기, 관리자만 쓰기
    match /education_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 누적 방문자 카운터 — 누구나 읽기, 1에서 시작해 1씩 증가만 허용
    match /stats/{docId} {
      allow read: if true;
      allow create: if request.resource.data.total == 1;
      allow update: if request.resource.data.total is int
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if isAdmin();
    }

    // 오늘 방문자 카운터 (날짜별 문서) — 누구나 읽기, 1에서 시작해 1씩 증가만 허용
    match /daily_visits/{dateId} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // AI 툴 목록 — 누구나 읽기, 관리자만 쓰기
    match /ai_tools/{toolId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 교육자 커뮤니티 게시판 — 누구나 읽기, 로그인 사용자 글쓰기,
    // 본인 글 또는 관리자만 삭제. 필드 형식·길이를 서버에서 강제.
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 5000
        && request.resource.data.category in ['수업 사례', '바이브코딩 쇼케이스', '질문·고민', '자료 공유', '자유', '강연 후기']
        // '강연 후기'는 신청자에게 보여줄 검증된 후기이므로 관리자만 작성 가능
        && (request.resource.data.category != '강연 후기' || isAdmin())
        && (!('projectUrl' in request.resource.data) || (request.resource.data.projectUrl is string && request.resource.data.projectUrl.size() <= 300))
        && (!('aiTool' in request.resource.data) || (request.resource.data.aiTool is string && request.resource.data.aiTool.size() <= 60))
        && (!('process' in request.resource.data) || (request.resource.data.process is string && request.resource.data.process.size() <= 4000))
        && (!('authorAffiliation' in request.resource.data) || (request.resource.data.authorAffiliation is string && request.resource.data.authorAffiliation.size() <= 60));
      // 본문 수정은 불가. 좋아요/댓글 수 카운터 한 개만 ±1 변경하는 것은 허용
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && request.resource.data.get('likeCount', 0) >= 0
        && request.resource.data.get('commentCount', 0) >= 0
        && ((request.resource.data.get('likeCount', 0) - resource.data.get('likeCount', 0))
          + (request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0))) in [1, -1];
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid);

      // 댓글 — 누구나 읽기, 로그인 사용자 작성, 본인 또는 관리자만 삭제
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.authorName.size() <= 50
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000;
        allow update: if false;
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.authorUid == request.auth.uid);
      }

      // 좋아요 — 문서 ID = 누른 사람의 uid (1인 1개), 본인만 등록/취소
      match /likes/{likeUid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == likeUid;
        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == likeUid);
      }
    }

    // 사이트 내 알림 (내 글에 새 댓글) — 수신자 본인만 읽기/읽음 처리/삭제
    match /notifications/{noteId} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type in ['comment']
        && request.resource.data.postId is string
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 120
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 50
        && request.resource.data.read == false;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.toUid == request.auth.uid);
    }

    // 지식 자산 공간 — 읽기·쓰기 모두 관리자만 (knowledge-admin.html)
    // knowledge_input: 지식 창고 / knowledge_output: 결과물 초고
    match /knowledge_input/{docId} {
      allow read, write: if isAdmin();
    }
    match /knowledge_output/{docId} {
      allow read, write: if isAdmin();
    }

    // 운영자 전용 콘텐츠 공간 — 읽기·쓰기 모두 관리자만 (contents-admin.html)
    // contents_input: 정제·태깅된 원천 콘텐츠 / contents_output: 이를 바탕으로 만든 결과물
    match /contents_input/{docId} {
      allow read, write: if isAdmin();
    }
    match /contents_output/{docId} {
      allow read, write: if isAdmin();
    }

    // ===== 교육 후기 아카이브 (reviews-admin.html / reviews 공개 페이지) =====
    // 공개 읽기: 게시(published) + 작성자 공개 동의 확인(confirmed)된 문서만. 그 외(임시저장·비공개·동의 전)는 관리자만.
    // 쓰기: 관리자만. 동의가 확인되지 않은 후기는 'published'로 저장할 수 없음(AI 정리 결과 자동 공개 차단).
    function validReview(d) {
      return d.keys().hasOnly(['slug', 'title', 'authorDisplay', 'anonymous', 'authorType', 'program', 'categories',
          'institution', 'reviewDate', 'concernBefore', 'memorablePractice', 'changeAfter', 'adminSummary',
          'originalText', 'sourceUrl', 'images', 'consentStatus', 'status', 'featured', 'summaryOrigin',
          'aiDraft', 'importBatch', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.slug is string && d.slug.matches('^[a-z0-9][a-z0-9-]{1,79}$')
        && d.title is string && d.title.size() <= 120
        && d.originalText is string && d.originalText.size() <= 20000
        && d.status in ['draft', 'published', 'private']
        && d.consentStatus in ['pending', 'confirmed', 'denied']
        && (d.status != 'published'
            || (d.consentStatus == 'confirmed' && d.title.size() >= 1 && d.originalText.size() >= 1))
        && (!('authorDisplay' in d) || (d.authorDisplay is string && d.authorDisplay.size() <= 50))
        && (!('anonymous' in d) || d.anonymous is bool)
        && (!('featured' in d) || d.featured is bool)
        && (!('authorType' in d) || d.authorType in ['', '교사', '교수', '교육담당자', '기타'])
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 5))
        && (!('institution' in d) || (d.institution is string && d.institution.size() <= 80))
        && (!('reviewDate' in d) || (d.reviewDate is string && (d.reviewDate == '' || d.reviewDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('concernBefore' in d) || (d.concernBefore is string && d.concernBefore.size() <= 1000))
        && (!('memorablePractice' in d) || (d.memorablePractice is string && d.memorablePractice.size() <= 1000))
        && (!('changeAfter' in d) || (d.changeAfter is string && d.changeAfter.size() <= 1000))
        && (!('adminSummary' in d) || (d.adminSummary is string && d.adminSummary.size() <= 1000))
        && (!('sourceUrl' in d) || (d.sourceUrl is string && d.sourceUrl.size() <= 500
            && (d.sourceUrl == '' || d.sourceUrl.matches('^https?://.*'))))
        && (!('images' in d) || (d.images is list && d.images.size() <= 12));
    }
    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || (resource.data.status == 'published' && resource.data.consentStatus == 'confirmed');
      allow create, update: if isAdmin() && validReview(request.resource.data);
      allow delete: if isAdmin();
    }
    // 후기 비공개 정보 (실명·연락처·원래 소속·공개 동의 기록·운영 메모) — 관리자만 읽기/쓰기
    match /review_private/{reviewId} {
      allow read, write: if isAdmin();
    }

    // 신고 — 로그인 사용자만 접수, 관리자만 열람/처리
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment']
        && request.resource.data.postId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 200;
      allow update: if false;
    }
  }
}
